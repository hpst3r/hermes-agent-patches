 import tools.delegate_tool as dt
@@ -73,6 +75,46 @@ def test_batch_overflow_trimmed_and_spilled_losslessly(monkeypatch):
 
 
 
+def test_schema_valid_json_survives_budget_while_prose_is_still_trimmed(monkeypatch, tmp_path):
+    """A schema-validated summary is the child's raw JSON contract response; a head+tail window plus footer
+    would leave schema_valid=true beside unparseable text. Ordinary prose in the same batch keeps the
+    spill-and-trim path."""
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / ".hermes"))
+    big_json = '{"payload":"' + ("X" * 50_000) + '"}'
+    big_prose = "HEAD_MARKER\n" + ("Y" * 50_000) + "\nTAIL_MARKER"
+    parent = _FakeParent(context_length=131_000, used_tokens=120_000, max_tokens=8_000)
+    results = [
+        {"task_index": 0, "summary": big_json, "status": "completed", "schema_valid": True},
+        {"task_index": 1, "summary": big_prose, "status": "completed"},
+        {"task_index": 2, "summary": big_json, "status": "completed", "schema_valid": False},
+    ]
+    dt._apply_summary_budget(results, parent)
+    assert results[0]["summary"] == big_json
+    assert json.loads(results[0]["summary"])["payload"] == "X" * 50_000
+    assert "summary_truncated" not in results[0]
+    for trimmed in results[1:]:
+        assert trimmed["summary_truncated"] is True
+        assert len(trimmed["summary"]) < 50_000
+    assert "TAIL_MARKER" in results[1]["summary"]
+
+
+def test_exempt_json_still_counts_toward_the_batch_split(monkeypatch, tmp_path):
+    """The exempt summary still occupies parent context, so the per-summary cap for the rest of the batch is
+    split across every summary, not only the trimmable ones."""
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / ".hermes"))
+    parent = _FakeParent(context_length=200_000, used_tokens=150_000, max_tokens=8_000)
+    big = "Z" * 200_000
+    alone = [{"task_index": 0, "summary": big, "status": "completed"}]
+    beside_json = [
+        {"task_index": 0, "summary": big, "status": "completed"},
+        {"task_index": 1, "summary": '{"ok": true}', "status": "completed", "schema_valid": True},
+    ]
+    with patch.object(dt, "_load_config", return_value={"max_summary_chars": 0}):
+        dt._apply_summary_budget(alone, parent)
+        dt._apply_summary_budget(beside_json, parent)
+    assert len(beside_json[0]["summary"]) < len(alone[0]["summary"])
+
+
 def test_budget_uses_current_prompt_size_not_the_session_sum():
     """A long-lived parent has a session sum far past any window while its current prompt is small; the
     budget must follow the current prompt, otherwise every summary collapses to the floor."""
