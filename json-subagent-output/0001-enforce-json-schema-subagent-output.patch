diff --git a/tests/tools/test_delegate_output_schema_prompt.py b/tests/tools/test_delegate_output_schema_prompt.py
new file mode 100644
index 0000000000..c3d66c4c91
--- /dev/null
+++ b/tests/tools/test_delegate_output_schema_prompt.py
@@ -0,0 +1,103 @@
+"""output_schema reaches the child as the LAST block of its system prompt, not as task context.
+
+A prose-summary request after (or instead of) the contract made children answer with Markdown-wrapped JSON that the
+strict validator rejects. These tests dispatch through the real ``delegate_task`` and inspect the system
+prompt the child AIAgent is actually constructed with.
+"""
+
+import json
+import threading
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+import run_agent
+from tools import delegate_tool
+
+SCHEMA = {
+    "type": "object",
+    "properties": {"healthy": {"type": "array", "items": {"type": "string"}}},
+    "required": ["healthy"],
+}
+CONTRACT_HEADER = "OUTPUT CONTRACT (machine-validated):"
+
+
+def _parent():
+    parent = MagicMock()
+    parent._delegate_depth = 0
+    parent._active_children = []
+    parent._active_children_lock = threading.Lock()
+    parent._session_db = None
+    parent.enabled_toolsets = ["terminal", "file", "delegation"]
+    parent.disabled_toolsets = []
+    parent.request_overrides = {}
+    parent.provider = "custom"
+    parent.base_url = "https://fixture.invalid/v1"
+    parent.api_key = "fixture-only"
+    parent.api_mode = "chat_completions"
+    parent.model = "fixture"
+    parent.platform = "cli"
+    parent._print_fn = None
+    parent.tool_progress_callback = None
+    parent.thinking_callback = None
+    return parent
+
+
+def _dispatch(tmp_path, monkeypatch, task, *, orchestrator, final_response):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    child = MagicMock()
+    child._credential_pool = None
+    child._delegate_saved_tool_names = []
+    child.session_prompt_tokens = 0
+    child.session_completion_tokens = 0
+    child.model = "fixture"
+    child.run_conversation.return_value = {
+        "final_response": final_response, "completed": True, "api_calls": 1, "messages": [],
+    }
+    config = {"max_spawn_depth": 3 if orchestrator else 1, "orchestrator_enabled": orchestrator}
+    with (
+        patch.object(delegate_tool, "_load_config", return_value=config),
+        patch.object(delegate_tool, "_resolve_workspace_hint", return_value=str(tmp_path)),
+        patch.object(run_agent, "AIAgent", return_value=child) as agent_class,
+    ):
+        result = json.loads(delegate_tool.delegate_task(tasks=[task], background=False, parent_agent=_parent()))
+    assert "error" not in result
+    return agent_class.call_args.kwargs["ephemeral_system_prompt"], result["results"][0]
+
+
+@pytest.mark.parametrize("orchestrator", [False, True])
+def test_contract_is_the_final_system_prompt_block(tmp_path, monkeypatch, orchestrator):
+    task = {"goal": "Check the endpoints", "context": "a.example and b.example", "output_schema": SCHEMA}
+    prompt, entry = _dispatch(tmp_path, monkeypatch, task, orchestrator=orchestrator,
+                              final_response='{"healthy": ["a.example"]}')
+
+    assert prompt.count(CONTRACT_HEADER) == 1
+    assert prompt.rstrip().endswith(json.dumps(SCHEMA, indent=2, ensure_ascii=False))
+    contract_at = prompt.index(CONTRACT_HEADER)
+    assert prompt.index("a.example and b.example") < prompt.index("Important workspace rule") < contract_at
+    # Nothing in the prompt asks for a prose summary that would contradict the raw-JSON contract.
+    assert "follow the OUTPUT CONTRACT at the end of this system prompt" in prompt
+    assert "concise summary" not in prompt
+    assert "Keep your final summary tight" not in prompt
+    if orchestrator:
+        assert prompt.index("Subagent Spawning (Orchestrator Role)") < contract_at
+        assert "final JSON contract response" in prompt
+        assert "final summary, not your workers" not in prompt
+    else:
+        assert "Subagent Spawning" not in prompt
+    assert entry["schema_valid"] is True
+    assert json.loads(entry["summary"]) == {"healthy": ["a.example"]}
+
+
+@pytest.mark.parametrize("orchestrator", [False, True])
+def test_schema_less_child_keeps_the_prose_summary_prompt(tmp_path, monkeypatch, orchestrator):
+    task = {"goal": "Check the endpoints", "context": "a.example and b.example"}
+    prompt, entry = _dispatch(tmp_path, monkeypatch, task, orchestrator=orchestrator, final_response="All healthy.")
+
+    assert "OUTPUT CONTRACT" not in prompt
+    assert "provide a clear, concise summary" in prompt
+    assert "Keep your final summary tight" in prompt
+    if orchestrator:
+        assert "final summary, not your workers" in prompt
+    assert entry["summary"] == "All healthy."
+    assert "schema_valid" not in entry
