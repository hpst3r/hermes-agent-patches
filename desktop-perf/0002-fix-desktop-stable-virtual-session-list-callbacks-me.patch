+  onResumeSession: (sessionId: string, session?: SessionInfo) => void
+  onTogglePin: (sessionId: string) => void
+  onToggleUnread: (sessionId: string) => void
+}
+
+interface VirtualRowShellProps {
+  branchStem: string | undefined
